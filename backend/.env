APP_NAME="InterviewGPT API"
APP_ENV="local"
APP_DEBUG="true"
APP_LOG_LEVEL="INFO"
APP_LOG_JSON="false"
APP_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Security
APP_CORS_ALLOW_CREDENTIALS="true"
APP_TRUSTED_HOSTS="*"

# Database (placeholder; wiring exists, integration later)
APP_DATABASE_URL=postgresql+psycopg://postgres:Nivash%40123@localhost:5432/interviewgpt

# Auth (placeholder; implementation later)
APP_JWT_ISSUER="interviewgpt"
APP_JWT_AUDIENCE="interviewgpt"
APP_JWT_SECRET=my-super-secret-key-12345678901234567890
APP_JWT_ALGORITHM="HS256"
APP_ACCESS_TOKEN_EXPIRE_SECONDS="900"
APP_REFRESH_TOKEN_EXPIRE_SECONDS="604800"
APP_EMAIL_VERIFICATION_EXPIRE_SECONDS="86400"
APP_PASSWORD_RESET_EXPIRE_SECONDS="3600"
APP_REQUIRE_EMAIL_VERIFICATION=false
APP_PUBLIC_BASE_URL="http://localhost:8000"

APP_RESUME_UPLOAD_DIR=uploads/resumes
APP_RESUME_MAX_FILE_SIZE_BYTES=5242880

